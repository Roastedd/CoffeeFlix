+++ b/src/render/wiiu/SDL_render_wiiu.c
@@ -167,6 +167,26 @@ void WIIU_SDL_CreateWindowTex(SDL_Renderer * renderer, SDL_Window * window)
 
     /* Setup texture and color buffer for the window */
     WIIU_SDL_CreateTexture(renderer, &data->windowTex);
+
+    /* A window larger than 1280x720 (a 1080p TV's size) gets a 1280x720 copy for the GamePad,
+       which shows it at 854x480: made that small in one step, the window would lose detail.
+       From MEM2: the MEM1 heap is made anew when the app comes back to the foreground, before
+       this frees the old copy. */
+    if (data->drcTex.driverdata) {
+        WIIU_SDL_DestroyTexture(renderer, &data->drcTex);
+        data->drcTex = (SDL_Texture) {0};
+    }
+    if (data->windowTex.w > 1280 && data->windowTex.h > 720) {
+        data->drcTex = (SDL_Texture) {
+            .format = SDL_PIXELFORMAT_RGBA8888,
+            .scaleMode = SDL_ScaleModeLinear,
+            .w = 1280,
+            .h = 720,
+        };
+        if (WIIU_SDL_CreateTexture(renderer, &data->drcTex) != 0) {
+            data->drcTex = (SDL_Texture) {0};
+        }
+    }
 }
 
