@@ -46,6 +46,13 @@ static SDL_bool tvDrcEnabled = SDL_FALSE;
    video stream to it is stopped now */
 static int padPicture = 0;
 static SDL_bool padStreamStopped = SDL_FALSE;
+/* A picture of its own for the GamePad (SDL_WiiUSetGamePadTexture) */
+static SDL_Texture *padTexture = NULL;
+
+void SDL_WiiUSetGamePadTexture(SDL_Texture *texture)
+{
+    padTexture = texture;
+}
 
