 extern DECLSPEC void SDLCALL SDL_WiiUSetAudioOutputs(SDL_bool tv, SDL_bool gamepad);
 
+/**
+ * Makes the GamePad show a texture of its own instead of the window's picture.
+ *
+ * The texture is drawn to as a render target (SDL_TEXTUREACCESS_TARGET, any
+ * size, drawn at the GamePad's 16:9). It is shown from the next
+ * SDL_RenderPresent on, until this is called with NULL. The TV keeps the
+ * window's picture. While the system keyboard is open, or the GamePad's picture
+ * is not sent (SDL_WiiUSetGamePadPicture), the window's picture is used. Call
+ * it with NULL before destroying the texture.
+ *
+ * \param texture a render target texture, or NULL for the window's picture
+ */
+extern DECLSPEC void SDLCALL SDL_WiiUSetGamePadTexture(SDL_Texture * texture);
+
 /**
  * Sets the swkbd's hint text.
