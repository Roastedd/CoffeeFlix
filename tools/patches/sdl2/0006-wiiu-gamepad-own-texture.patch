+    /* Its own picture goes to the GamePad as it is: drawn there already, at the size it wants */
+    if (sendToPad && !keyboard && padTexture && padTexture->driverdata && !(flags & SDL_WINDOW_WIIU_TV_ONLY)) {
+        drc = (WIIU_TextureData *) padTexture->driverdata;
+    } else if (sendToPad && data->drcTex.driverdata && !(flags & SDL_WINDOW_WIIU_TV_ONLY) && WIIU_SDL_DrawDRCCopy(data)) {
