+ * \param tv SDL_TRUE to play on the TV
+ * \param gamepad SDL_TRUE to play on the GamePad (its speakers and the
+ *                headphones plugged into it)
+ */
+extern DECLSPEC void SDLCALL SDL_WiiUSetAudioOutputs(SDL_bool tv, SDL_bool gamepad);
