+/*  Which outputs the sound plays on (SDL_WiiUSetAudioOutputs): what's asked for, and what the
+    voices are mixed to now. The AX frame callback makes the second the first. */
+static volatile int wantTv = 1, wantGamePad = 1;
+static int haveTv = 1, haveGamePad = 1;
+static AXVoiceDeviceMixData silent_mix[AX_NUM_CHANNELS];
+
+void SDL_WiiUSetAudioOutputs(SDL_bool tv, SDL_bool gamepad) {
+    wantTv = tv ? 1 : 0;
+    wantGamePad = gamepad ? 1 : 0;
+}
+
+/*  Plays the voices on a device as at the start, or silent */
+static void _WIIUAUDIO_setoutput(AXDeviceType device, int on) {
+    for (int i = 0; i < cb_this->spec.channels; i++) {
+        AXVoiceDeviceMixData* mix = silent_mix;
+        if (on) mix = cb_this->spec.channels == 1 ? mono_mix[i] : stereo_mix[i];
+        AXSetVoiceDeviceMix(cb_hidden->voice[i], device, 0, mix);
+    }
+}
