@@ -206,6 +223,12 @@ int WIIU_SDL_RenderPresent(SDL_Renderer * renderer)
         tvDrcEnabled = SDL_TRUE;
     }
 
+    /* The GamePad's video stream stopped, or running again */
+    if (tvDrcEnabled && (padPicture == 2) != padStreamStopped) {
+        padStreamStopped = (padPicture == 2);
+        GX2SetDRCEnable(!padStreamStopped);
+    }
