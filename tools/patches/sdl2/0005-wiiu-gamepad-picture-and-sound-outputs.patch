 static SDL_bool tvDrcEnabled = SDL_FALSE;
 
+/* What the GamePad gets of the window (SDL_WiiUSetGamePadPicture), and whether the console's
+   video stream to it is stopped now */
+static int padPicture = 0;
+static SDL_bool padStreamStopped = SDL_FALSE;
+
+void SDL_WiiUSetGamePadPicture(int mode)
+{
+    padPicture = mode;
+}
+
+/* Leaving the foreground turns the GamePad's output back on (SDL_wiiuvideo.c) */
+void WIIU_SDL_ResetGamePadStream(void)
+{
+    padStreamStopped = SDL_FALSE;
+}
+
 int WIIU_SDL_SetVSync(SDL_Renderer * renderer, const int vsync)
