+/**
+ * Chooses what the GamePad gets of the window.
+ *
+ * 0 (the default): the window's picture, as usual. 1: no picture is sent to
+ * it: the GamePad keeps showing the last one, and the copy of a larger window
+ * isn't drawn either. 2: as 1, and the console stops its video stream to the
+ * GamePad (GX2SetDRCEnable); it comes back with the foreground. The TV is not
+ * affected.
+ *
+ * \param mode 0, 1 or 2
+ */
+extern DECLSPEC void SDLCALL SDL_WiiUSetGamePadPicture(int mode);
+
+/**
+ * Chooses which of the outputs the sound plays on. Both by default.
