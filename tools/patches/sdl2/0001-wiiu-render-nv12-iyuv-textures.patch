+++ b/src/render/wiiu/shaders/yuvShader.psh
@@ -0,0 +1,52 @@
+; $MODE = "UniformRegister"
+
+; $NUM_SPI_PS_INPUT_CNTL = 2
+; v_color R0
+; $SPI_PS_INPUT_CNTL[0].SEMANTIC = 0
+; $SPI_PS_INPUT_CNTL[0].DEFAULT_VAL = 1
+; v_texCoord R1
+; $SPI_PS_INPUT_CNTL[1].SEMANTIC = 1
+; $SPI_PS_INPUT_CNTL[1].DEFAULT_VAL = 1
+
+; C0 = offset added to (Y, U, V)
+; C1, C2, C3 = contribution of Y, U, V to (R, G, B)
+; $UNIFORM_VARS[0].name = "u_yuv"
+; $UNIFORM_VARS[0].type = "mat4"
+; $UNIFORM_VARS[0].count = 1
+; $UNIFORM_VARS[0].offset = 0
+
+; $SAMPLER_VARS[0].name = "u_texY"
+; $SAMPLER_VARS[0].type = "SAMPLER2D"
+; $SAMPLER_VARS[0].location = 0
+; $SAMPLER_VARS[1].name = "u_texU"
+; $SAMPLER_VARS[1].type = "SAMPLER2D"
+; $SAMPLER_VARS[1].location = 1
+; $SAMPLER_VARS[2].name = "u_texV"
+; $SAMPLER_VARS[2].type = "SAMPLER2D"
+; $SAMPLER_VARS[2].location = 2
+
+; U is read from t1.x and V from t2.y, so NV12 binds its UV plane to both
+; and planar YUV binds the U and V planes (each replicated across channels).
+; Every value lands in its own channel to avoid GPR read port conflicts.
+00 TEX: ADDR(48) CNT(3) VALID_PIX
+    0  SAMPLE R2.x___, R1.xy0x, t0, s0
+    1  SAMPLE R3._x__, R1.xy0x, t1, s1
+    2  SAMPLE R4.__y_, R1.xy0x, t2, s2
+01 ALU: ADDR(32) CNT(15)
+    3  x: ADD    R5.x, R2.x, C0.x
+       y: ADD    R5.y, R3.y, C0.y
+       z: ADD    R5.z, R4.z, C0.z
+    4  x: MUL    R6.x, R5.x, C1.x
+       y: MUL    R6.y, R5.x, C1.y
+       z: MUL    R6.z, R5.x, C1.z
+    5  x: MULADD R6.x, R5.y, C2.x, R6.x
+       y: MULADD R6.y, R5.y, C2.y, R6.y
+       z: MULADD R6.z, R5.y, C2.z, R6.z
+    6  x: MULADD R6.x, R5.z, C3.x, R6.x
+       y: MULADD R6.y, R5.z, C3.y, R6.y
+       z: MULADD R6.z, R5.z, C3.z, R6.z
+    7  x: MUL    R0.x, R0.x, R6.x
+       y: MUL    R0.y, R0.y, R6.y
+       z: MUL    R0.z, R0.z, R6.z
+02 EXP_DONE: PIX0, R0
+END_OF_PROGRAM
