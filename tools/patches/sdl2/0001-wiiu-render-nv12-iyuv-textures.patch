+static void WIIU_DestroyPlanes(WIIU_TextureData *tdata)
+{
+    int i;
+
+    if (tdata->texture.surface.image) {
+        GX2RDestroySurfaceEx(&tdata->texture.surface, 0);
+    }
+    for (i = 0; i < 2; i++) {
+        if (tdata->planes[i].surface.image) {
+            GX2RDestroySurfaceEx(&tdata->planes[i].surface, 0);
+        }
