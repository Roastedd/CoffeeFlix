+        ok = ok && WIIU_CreatePlane(&tdata->planes[0], cw, ch, GX2_SURFACE_FORMAT_UNORM_R8_G8,
+                                    GX2_COMP_MAP(GX2_SQ_SEL_R, GX2_SQ_SEL_G, GX2_SQ_SEL_0, GX2_SQ_SEL_1));
+    } else {
