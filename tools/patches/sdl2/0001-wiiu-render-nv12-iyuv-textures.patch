+static int WIIU_SDL_CreateYUVTexture(SDL_Texture * texture, WIIU_TextureData *tdata)
+{
+    const uint32_t repeat = GX2_COMP_MAP(GX2_SQ_SEL_R, GX2_SQ_SEL_R, GX2_SQ_SEL_R, GX2_SQ_SEL_1);
+    const int cw = (texture->w + 1) / 2, ch = (texture->h + 1) / 2;
+    SDL_bool ok = WIIU_CreatePlane(&tdata->texture, texture->w, texture->h, GX2_SURFACE_FORMAT_UNORM_R8, repeat);
+
+    if (texture->format == SDL_PIXELFORMAT_NV12) {
