+    tex->viewNumSlices = 1;
+    tex->compMap = compMap;
+    GX2CalcSurfaceSizeAndAlignment(&tex->surface);
+    GX2InitTextureRegs(tex);
+
+    return GX2RCreateSurface(&tex->surface,
+                             GX2R_RESOURCE_BIND_TEXTURE |
+                             GX2R_RESOURCE_USAGE_CPU_WRITE | GX2R_RESOURCE_USAGE_CPU_READ |
