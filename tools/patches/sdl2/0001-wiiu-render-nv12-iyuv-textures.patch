+    WIIU_RenderData *data = (WIIU_RenderData *) renderer->driverdata;
+
+    if (!tdata->ownImage[0]) {
+        return;
+    }
+    tdata->texture.surface.image = tdata->ownImage[0];
+    tdata->planes[0].surface.image = tdata->ownImage[1];
+    tdata->ownImage[0] = tdata->ownImage[1] = NULL;
+    /* The GPU is told where a texture is when it's bound */
+    if (data->drawState.texture == texture) {
