+        ok = ok && WIIU_CreatePlane(&tdata->planes[1], cw, ch, GX2_SURFACE_FORMAT_UNORM_R8, repeat);
+    }
+    if (!ok) {
+        WIIU_DestroyPlanes(tdata);
+        SDL_free(tdata);
+        return SDL_OutOfMemory();
