index cbaf703..0f8fa83 100644
--- a/src/render/wiiu/SDL_rqueue_wiiu.c
+++ b/src/render/wiiu/SDL_rqueue_wiiu.c
@@ -282,7 +282,9 @@ static int WIIU_SDL_SetDrawState(WIIU_RenderData * data, const SDL_RenderCommand
     const SDL_BlendMode blendMode = cmd->data.draw.blend;
     SDL_Texture *texture = cmd->data.draw.texture;
     WIIU_TextureData *tdata = texture ? (WIIU_TextureData *) texture->driverdata : NULL;
-    WIIU_ShaderType shader = !tdata ? SHADER_COLOR : tdata->numPlanes ? SHADER_YUV : SHADER_TEXTURE;
+    WIIU_ShaderType shader = !tdata ? SHADER_COLOR : !tdata->numPlanes ? SHADER_TEXTURE :
+                             /* "best" YUV textures: Y through a bicubic filter */
+                             texture->scaleMode == SDL_ScaleModeBest ? SHADER_YUV_BICUBIC : SHADER_YUV;
     WiiU_ShaderGroup* shaderGroup = WIIU_SDL_GetShaderGroup(shader);
 
     if (data->drawState.viewportDirty) {
@@ -364,9 +366,14 @@ static int WIIU_SDL_SetDrawState(WIIU_RenderData * data, const SDL_RenderCommand
         data->drawState.texture = texture;
     }
 
-    if (shader == SHADER_YUV) {
+    if (shader == SHADER_YUV || shader == SHADER_YUV_BICUBIC) {
         GX2SetPixelUniformReg(shaderGroup->pixelShader->uniformVars[0].offset, 16, tdata->yuvMatrix);
     }
+    if (shader == SHADER_YUV_BICUBIC) {
+        /* The Y plane's size, and one over it */
+        float size[4] = { (float) texture->w, (float) texture->h, 1.0f / texture->w, 1.0f / texture->h };
+        GX2SetPixelUniformReg(shaderGroup->pixelShader->uniformVars[1].offset, 4, size);
+    }
 
     if (tdata) {
         WIIU_TextureMarkUsed(data, tdata);
