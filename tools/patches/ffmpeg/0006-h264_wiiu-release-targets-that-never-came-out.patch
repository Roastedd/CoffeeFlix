+// Notes that the slot was just filled, for the packet now being handed over.
+static inline void wiiu_target_filled(WiiUFrameTargets* targets, AVFrame** slot) {
+    targets->sent_at[slot - targets->frames] = targets->clock;
+}
+// A target nothing has come out of for this many packets is one the decoder is not going to write: its packet failed
+// or brought no picture (the decoder holds a picture back for 16 packets at most). Without this, each such packet
+// kept a slot for good, and after eight of them every picture was copied (about 18 frames a second).
+static inline int wiiu_targets_expire(WiiUFrameTargets* targets, uint32_t max_age) {
+    int i, n = 0;
+    for (i = 0; i < WIIU_MAX_TARGETS; ++i) {
+        if (targets->frames[i] && (uint32_t)(targets->clock - targets->sent_at[i]) > max_age) {
+            av_frame_free(&targets->frames[i]);
+            n++;
+        }
+    }
+    return n;
+}
